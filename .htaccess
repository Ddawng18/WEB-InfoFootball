# FastFootBalInfo - bảo vệ các thư mục không được phục vụ trực tiếp.
# Chạy được với Apache 2.4 (XAMPP). Với PHP built-in server, dùng router.php.

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Chặn truy cập trực tiếp mã nguồn, dữ liệu, cấu hình, view, cache, tài liệu.
    RewriteRule ^(app|api/\.|database|tools|config|views)(/|$) - [F,L]
    RewriteRule ^(config\.ini|config\.example\.ini|README\.md|\.gitignore|\.git)(/|$) - [F,L]
</IfModule>

# Chặn các file nhạy cảm dù rewrite không bật.
<FilesMatch "\.(ini|sql|log|bak|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
